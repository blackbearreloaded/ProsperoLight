+    [Fact]
+    public void Write_LeavesSpaceBetweenWritableMemoryAndTheLinkingSegment()
+    {
+        // GuardResolution ends its writable memory on a 16-byte boundary. The old alignment expression
+        // consequently placed the unprotected linking segment at that exact same address, unlike both
+        // the working control and retail modules, which leave a positive gap.
+        List<Phdr> phdrs = ReadProgramHeaders(
+            DynamicWriter.Write(GuardResolution(), "main"));
+        Phdr dynlib = Assert.Single(phdrs, p => p.Type == 1 && p.Flags == 0);
+        Phdr writable = phdrs
+            .Where(p => p.Type == 1 && p.Flags == 6)
+            .OrderByDescending(p => p.Addr)
+            .First();
+
+        Assert.True(dynlib.Addr > writable.Addr + writable.MemSize,
+            "the linking segment touches writable memory");
+        Assert.Equal(0ul, dynlib.Addr % 16);
+    }
